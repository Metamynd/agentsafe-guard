{
  "_comment": [
    "MAGP payload-binding conformance vectors (spec section 8.3.9).",
    "Generated from backend/src/features/magp/payload-binding.ts (backend/scripts/generate-payload-vectors.ts), which is the source of truth.",
    "Every implementation MUST reproduce `canonical` and `digest` from `jsonText` (RFC 8785 canonical JSON, SHA-256 of its UTF-8 bytes, prefixed \"sha256:\"), MUST refuse every `reject` case, and for `binding` MUST reproduce `message` and the Ed25519 `signature` under `seed`.",
    "The seed is the public RFC 8032 section 7.1 test vector 1 key. It is a test key, never a secret, and must never be used for a real agent.",
    "The suites that read this file: backend/src/features/magp/payload-binding.test.ts and integrations/metamynd-client/tests/test_payload_vectors.py."
  ],
  "algorithm": "Ed25519",
  "canonicalization": "RFC 8785 (JCS)",
  "digestFormat": "sha256:<64 lower-case hex>",
  "messageFormat": "MAGP-PAYLOAD-v1|agentDid|action|nonce|issuedAt|payloadDigest  (each field: \"\\\" then \"|\" backslash-escaped)",
  "seed": "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
  "publicKey": "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
  "canonical": [
    {
      "name": "empty object",
      "note": "the smallest payload",
      "jsonText": "{}",
      "canonical": "{}",
      "digest": "sha256:44136fa355b3678a1146ad16f7e8649e94fb4fc21fe77e8310c060f61caaff8a"
    },
    {
      "name": "key order",
      "note": "keys are sorted, whatever order they arrive in",
      "jsonText": "{\"b\":1,\"a\":2,\"c\":{\"z\":1,\"y\":2}}",
      "canonical": "{\"a\":2,\"b\":1,\"c\":{\"y\":2,\"z\":1}}",
      "digest": "sha256:c0f8bd0ab5119fda84f6a24ed2eff88949e145d20f0a1eddbb51e14ef1eae3cb"
    },
    {
      "name": "nested and arrays",
      "note": "arrays keep their order; objects inside them are sorted",
      "jsonText": "{\"z\":[3,1,{\"y\":true,\"x\":null}],\"a\":\"s\"}",
      "canonical": "{\"a\":\"s\",\"z\":[3,1,{\"x\":null,\"y\":true}]}",
      "digest": "sha256:aa08acf41a1590999373e6ddd57be3aeb313b4b9d9c96a6b3f56e58bc0d70eb0"
    },
    {
      "name": "whitespace and formatting",
      "note": "insignificant whitespace is dropped",
      "jsonText": "{ \"a\" : 1 ,\n \"b\" : [ 1 , 2 ] }",
      "canonical": "{\"a\":1,\"b\":[1,2]}",
      "digest": "sha256:8baa73198470c7bb4c3ce142a8fd651affc0310d878bb9bd159e37a573fb4874"
    },
    {
      "name": "numbers",
      "note": "ECMAScript number serialisation: 1.0 is \"1\", -0 is \"0\", 1e21 is \"1e+21\", 1e-7 is \"1e-7\", 0.00005 is \"0.00005\"",
      "jsonText": "[0,-0,1,1.0,1.5,1e21,1e-7,0.00005,100,123456789012345680000,1E2,0.1]",
      "canonical": "[0,0,1,1,1.5,1e+21,1e-7,0.00005,100,123456789012345680000,100,0.1]",
      "digest": "sha256:cb10d3294169fe26d07130d63b32a52a575cbb2532a30e7c0a78e89af53cac32"
    },
    {
      "name": "numbers beyond 2**53",
      "note": "JSON.parse holds a double, so these are signed as the double, not their exact digits",
      "jsonText": "[9007199254740993,1152921504606846977]",
      "canonical": "[9007199254740992,1152921504606847000]",
      "digest": "sha256:ece0382d91a410f4c8d0d80f53f536fdf43c866403c0cb32870c78855cb5d5ff"
    },
    {
      "name": "string escapes",
      "note": "only \\\" \\\\ and the C0 controls are escaped (as \\b \\f \\n \\r \\t or \\u00xx lower-case); \"/\" and non-ASCII are not",
      "jsonText": "\"a\\\"b\\\\c\\n\\t\\u0001\\u001f\\u007f\\/ é ✓ 😀\"",
