{
  "name": "@metamynd/agentsafe-http-gateway",
  "version": "0.31.1",
  "description": "Generic HTTP interception gateway (SAFR §17) — a zero-dependency reverse proxy that governs arbitrary HTTP calls through the AgentSafe gate before forwarding upstream.",
  "type": "module",
  "main": "gateway.mjs",
  "bin": {
    "agentsafe-gateway": "cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./gateway.d.mts",
      "default": "./gateway.mjs"
    },
    "./route-match": {
      "types": "./route-match.d.mts",
      "default": "./route-match.mjs"
    },
    "./keepalive-fetch": "./keepalive-fetch.mjs",
    "./server": "./server.mjs",
    "./service-identity": {
      "types": "./service-identity.d.mts",
      "default": "./service-identity.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "service-identity.d.mts",
    "route-match.d.mts",
    "gateway.d.mts",
    "keepalive-fetch.mjs",
    "gateway.mjs",
    "route-match.mjs",
    "payload-binding.mjs",
    "server.mjs",
    "service-identity.mjs",
    "cli.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node gateway.smoke.mjs && node bind-payload.smoke.mjs && node payload-binding.smoke.mjs && node bind-payload.fuzz.mjs && node credential-vault.smoke.mjs && node gateway-settle.smoke.mjs && node settle-after-answer.smoke.mjs && node context-signature.smoke.mjs && node query-binding.smoke.mjs && node allowed-agents.smoke.mjs && node report-outcomes.smoke.mjs && node service-identity.smoke.mjs"
  },
  "dependencies": {
    "@metamynd/agentsafe-mcp-guard": "^0.31.0"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "keywords": [
    "http",
    "gateway",
    "reverse-proxy",
    "ai",
    "agent",
    "agents",
    "governance",
    "authorization",
    "trustless",
    "zero-trust",
    "magp",
    "metamynd",
    "agentsafe"
  ],
  "author": "MetaMynd",
  "license": "MIT",
  "homepage": "https://metamynd.ai/en/developers/spec",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metamynd/agentsafe-guard.git",
    "directory": "packages/agentsafe-http-gateway"
  },
  "bugs": {
    "url": "https://github.com/Metamynd/agentsafe-guard/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./gateway.d.mts"
}
